{
  "name": "ai-autonomous-testing-ego-lite",
  "version": "0.1.9",
  "egoLiteTest": {
    "toolRevision": "project-knowledge-3",
    "formatVersions": {
      "cases": 9,
      "manifest": 9,
      "results": 9,
      "evidence": 9,
      "report": 9,
      "execution": 9,
      "configuration": 9,
      "workerPacket": 9,
      "executionRead": 9
    },
    "networkFormatVersion": 1,
    "regressionVersion": 2,
    "knowledgeFormatVersion": 3
  },
  "description": "AI autonomous Web test automation with Ego Lite: evidence-driven planning, execution and offline HTML reports.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:bootstrap": "tsc -p tsconfig.tools.json",
    "contracts:write": "npm run build:bootstrap && node .build/bootstrap/tools/generate-contracts.mjs --write",
    "check:contracts": "npm run build:bootstrap && node .build/bootstrap/tools/generate-contracts.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.browser.json",
    "build": "npm run check:contracts && node .build/bootstrap/tools/generate-ui-catalog.mjs --check && node .build/bootstrap/tools/clean-build.mjs && tsc -p tsconfig.node.json && tsc -p tsconfig.browser.json && node .build/node/tools/bundle-file-readers.mjs && node .build/node/tools/bundle-review-ui.mjs && node .build/node/tools/bundle-report-ui.mjs && node .build/node/tools/stage-runtime.mjs --source-root .",
    "test": "npm run build && node --test .build/node/tests/*.test.mjs",
    "check:public": "npm run build:bootstrap && node .build/bootstrap/tools/public-check.mjs --root . --development",
    "build:skill": "npm run build && node .build/node/tools/build-skill.mjs",
    "ui:write": "npm run build:bootstrap && node .build/bootstrap/tools/generate-ui-catalog.mjs",
    "check:ui": "npm run build:bootstrap && node .build/bootstrap/tools/generate-ui-catalog.mjs --check"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "csv-parse": "7.0.3",
    "dompurify": "3.4.17",
    "marked": "18.1.2",
    "read-excel-file": "9.3.14"
  }
}
