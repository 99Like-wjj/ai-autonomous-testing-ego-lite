{
  "name": "ai-autonomous-testing-ego-lite",
  "version": "0.1.7-rc.1",
  "egoLiteTest": {
    "toolRevision": "report-usability-1",
    "formatVersions": {
      "cases": 7,
      "manifest": 7,
      "results": 7,
      "evidence": 7,
      "report": 7,
      "execution": 7,
      "configuration": 7,
      "workerPacket": 7,
      "executionRead": 7
    },
    "networkFormatVersion": 1
  },
  "description": "AI autonomous Web test automation with Ego Lite: evidence-driven planning, execution and offline HTML reports.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:bootstrap": "tsc -p tsconfig.tools.json",
    "contracts:write": "npm run build:bootstrap && node .build/bootstrap/tools/generate-contracts.mjs --write",
    "check:contracts": "npm run build:bootstrap && node .build/bootstrap/tools/generate-contracts.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.browser.json",
    "build": "npm run check:contracts && tsc -p tsconfig.node.json && tsc -p tsconfig.browser.json && node .build/node/tools/stage-runtime.mjs --source-root .",
    "test": "npm run build && node --test .build/node/tests/*.test.mjs",
    "check:public": "npm run build:bootstrap && node .build/bootstrap/tools/public-check.mjs --root . --development",
    "build:skill": "npm run build && node .build/node/tools/build-skill.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "6.0.3"
  }
}
