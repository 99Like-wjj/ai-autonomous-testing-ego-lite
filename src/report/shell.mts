-bottom:1px solid var(--line)}.viewer-controls{display:flex;gap:7px;flex-wrap:wrap}.viewerbody{height:calc(94vh - 150px);overflow:auto;padding:15px;display:flex}.viewerbody.fit img{max-width:100%;max-height:100%;object-fit:contain;margin:auto}.viewerbody.original,.viewerbody.zoom{display:block}.viewerbody.original img,.viewerbody.zoom img{max-width:none;max-height:none;display:block;margin:0 auto;filter:none}.viewcaption{padding:9px 16px;font-size:12px;color:var(--muted)}.zoom-label{font-size:12px;align-self:center}.library-controls{display:flex;gap:10px;flex-wrap:wrap;margin:12px 0}.library-controls label{font-weight:400}.objectlink{overflow-wrap:anywhere}.print-note{display:none}@media(max-width:1150px){.workspace{grid-template-columns:280px minmax(0,1fr);padding:18px 20px;gap:15px}.panel{padding:18px}.top,.overview{padding-left:20px;padding-right:20px}.compare{grid-template-columns:1fr}.thumb{height:190px}}@media(max-width:760px){.workspace{display:block;padding:13px}.sidebar{position:static;margin-bottom:15px}.list{max-height:320px}.top{display:block}.topright{justify-content:start;margin-top:12px}.contexts,.compare{grid-template-columns:1fr}.theme-grid{grid-template-columns:repeat(2,1fr)}.evidence-grid{grid-template-columns:1fr}.viewerbar{display:block}.viewer-controls{margin-top:8px}.viewerbody{height:calc(94vh - 195px)}h1{font-size:23px}h2{font-size:21px}}@media print{:root{--background:white!important;--panel:white!important;--surface:#f1f1f1!important;--ink:#111!important;--muted:#444!important;--line:#bbb!important;--accent:#222!important;color-scheme:light!important}body{background:white!important}.sidebar,.topright,.sectionlinks,.backbar,.toolbar,dialog{display:none!important}.workspace{display:block;padding:0}.panel{break-inside:avoid}.print-note{display:block}.top,.overview{padding:10px}footer{padding:10px}.body-text{max-height:none;overflow:visible}}
