/** Exact point comparisons. Status changes and AI attribution stay separate. */
import path from 'node:path';import fs from 'node:fs/promises';
import type {SourceRun,RunRef} from './model.mjs';
import type {RegressionBinding} from './binding.mjs';
import {assertClosed,canonical,canonicalHash,fail,inside,json,safeIdentifier,safePath,writeNew,removeOwnedFileIfPresent,errorInfo} from '../core/common.mjs';
import {arrayValue,oneOf,textValue,uniqueStrings} from '../core/validation.mjs';
import {parseRunRef} from './selection.mjs';import {verifyRunRef,pointDetails} from './sources.mjs';
export interface ComparisonDeclaration {pointId:string;state:'comparable'|'limited'|'not_directly_comparable';rationale:string;sources:{side:'left'|'right';kind:'result'|'evidence'|'binding';ref:string}[]}
export {pointDetails} from './sources.mjs';
export interface RegressionComparison {regressionVersion:2;left:RunRef;right:RunRef;rows:{pointId:string;left:ReturnType<typeof pointDetails>;right:ReturnType<typeof pointDetails>;differences:{aspect:string;changed:boolean;left:unknown;right:unknown}[];comparability:ComparisonDeclaration|null}[];unmapped:{left:string[];right:string[]};caveat:string;contentSha256:string}
export async function compareRuns({request:value}:{request:unknown}):Promise<RegressionComparison>{
 assertClosed(value,['regressionVersion','left','right','pointIds','comparability'],'comparison request');if(value.regressionVersion!==2)fail('Comparison requires regressionVersion 2.');const left=parseRunRef(value.left),right=parseRunRef(value.right),[l,r]=await Promise.all([verifyRunRef(left),verifyRunRef(right)]);if(l.baseline.projectId!==r.baseline.projectId)fail('Comparison runs belong to different projects.');
 const all=[...new Set([...l.checked.cases.flatMap(c=>c.goals.map(g=>g.pointId)),...r.checked.cases.flatMap(c=>c.goals.map(g=>g.pointId))])],pointIds=value.pointIds===undefined?all:uniqueStrings(value.pointIds,'comparison points',true);for(const id of pointIds)if(!all.includes(id))fail('Comparison point is outside both executed scopes: '+id);
 const declarations:ComparisonDeclaration[]=arrayValue(value.comparability??[],'AI comparability declarations').map(v=>{assertClosed(v,['pointId','state','rationale','sources'],'comparability');const pointId=safeIdentifier(v.pointId);if(!pointIds.includes(pointId))fail('Unknown comparability point.');const sources=arrayValue(v.sources,'comparability sources').map(s=>{assertClosed(s,['side','kind','ref'],'comparability source');return{side:oneOf(s.side,['left','right'],'comparison side'),kind:oneOf(s.kind,['result','evidence','binding'],'comparison source kind'),ref:textValue(s.ref,'source reference')};});if(!sources.length)fail('AI comparability requires actual source references.');return{pointId,state:oneOf(v.state,['comparable','limited','not_directly_comparable'],'comparability state'),rationale:textValue(v.rationale,'comparability rationale'),sources};});if(new Set(declarations.map(d=>d.pointId)).size!==declarations.length)fail('Duplicate comparability declaration.');
 const rows=pointIds.map(pointId=>{const a=pointDetails(l,pointId),b=pointDetails(r,pointId),declaration=declarations.find(d=>d.pointId===pointId)??null;for(const s of declaration?.sources??[]){const source=s.side==='left'?l:r,detail=s.side==='left'?a:b;if(s.kind==='result'&&(!detail?.selected||s.ref!==detail.caseId+'/'+detail.goalId))fail('Comparability result source must identify this selected goal.');if(s.kind==='evidence'&&!detail?.evidence.some(e=>e.id===s.ref))fail('Comparability evidence must support this exact goal.');if(s.kind==='binding'&&(source.checked.regressionBinding as RegressionBinding|undefined)?.contentSha256!==s.ref)fail('Comparability binding hash mismatch.');}
 const dims=(d:ReturnType<typeof pointDetails>,source:SourceRun)=>{
  const binding=source.checked.regressionBinding as RegressionBinding|undefined,declared=(aspect:string)=>binding?.currentConditions.items.filter(i=>i.caseIds.includes(d?.caseId??'')&&i.aspect===aspect)??[];
  return{rule:d?{basis:d.basis,expected:d.expected,clarification:d.definition.clarificationQuestions}:null,plan:d?.plan??null,identity:{facts:d?.contexts.map(c=>c.identity)??[],declarations:declared('identity')},environment:{facts:d?.contexts.map(c=>c.environment)??[],declarations:declared('environment')},data:{contexts:d?.contexts.map(c=>({objects:c.objects,initialState:c.initialState}))??[],bindings:binding?.parameterBindings.filter(p=>p.caseId===d?.caseId)??[],declarations:declared('data')},authorization:{facts:d?.contexts.map(c=>c.authorization)??[],declarations:declared('authorization')},scope:{selected:d?.selected??false,caseVersion:source.baseline.caseVersion,binding:binding?.selection.selectionSha256??null}};
 };const ld=dims(a,l),rd=dims(b,r);return{pointId,left:a,right:b,differences:Object.keys(ld).map(aspect=>({aspect,changed:canonical(ld[aspect as keyof typeof ld])!==canonical(rd[aspect as keyof typeof rd]),left:ld[aspect as keyof typeof ld],right:rd[aspect as keyof typeof rd]})),comparability:declaration};});
 const body={regressionVersion:2 as const,left:{...left,runDir:l.runDir},right:{...right,runDir:r.runDir},rows,unmapped:{left:all.filter(id=>!pointIds.includes(id)&&pointDetails(l,id)?.selected),right:all.filter(id=>!pointIds.includes(id)&&pointDetails(r,id)?.selected)},caveat:'A deterministic comparison is not a repair attribution. Status, original-problem recurrence, new findings and AI comparability are separate. Unselected points have no current verdict; historical evidence keeps its source run and collection identity.'};return{...body,contentSha256:canonicalHash(body)};
}
const label=(d:ReturnType<typeof pointDetails>)=>!d?'范围中不存在':!d.selected?'本轮未选中':d.status===null?'缺少评估':({verified:'已验证',violation:'发现违反',inconclusive:'无法判断',not_tested:'未测试'})[d.status];
const esc=(s:unknown)=>String(s).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;');
export async function writeComparison({outputDir,comparison}:{outputDir:unknown;comparison:RegressionComparison}) {
 const {contentSha256,...body}=comparison;if(canonicalHash(body)!==contentSha256)fail('Comparison fingerprint mismatch.');
 const target=await safePath(outputDir,{external:true});if([comparison.left.runDir,comparison.right.runDir].some(root=>inside(root,target)))fail('Comparison output must be outside its source runs.');
 await fs.mkdir(target,{mode:0o700});const directoryIdentity=await fs.lstat(target),owned:{file:string;identity:Awaited<ReturnType<typeof writeNew>>}[]=[];
 const md=(v:unknown)=>String(v).replace(/[\\*_{}\[\]()#+.!|~-]/g,c=>'\\'+c).split(String.fromCharCode(96)).join('\\'+String.fromCharCode(96)).replaceAll('<','&lt;').replaceAll('>','&gt;');
 const fence=String.fromCharCode(96).repeat(3);
 const markdown=['# 回归对照','','原运行与本次结果分别保留；状态变化不自动证明代码修复。','',...comparison.rows.flatMap(row=>['## '+md(row.pointId),'',label(row.left)+' → '+label(row.right),'','原预期：'+md(row.left?.expected??'无'),'','本次预期：'+md(row.right?.expected??'无'),'','AI 可比性：'+md(row.comparability?row.comparability.state+'；'+row.comparability.rationale:'尚未提供'),'',fence+'json',JSON.stringify(row,null,2).replaceAll(fence,'\\u0060\\u0060\\u0060'),fence,'']),comparison.caveat,''].join('\n');
 const html='<!doctype html><html lang="zh-CN"><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="default-src &#39;none&#39;; style-src &#39;unsafe-inline&#39;; base-uri &#39;none&#39;"><title>回归对照</title><style>body{max-width:1200px;margin:30px auto;padding:20px;font:15px/1.8 system-ui;color:#20334c}section{border-top:1px solid #cad6e4;padding:20px 0}pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#f1f5fa;padding:15px}</style><h1>回归对照</h1>'+comparison.rows.map(row=>'<section><h2>'+esc(row.pointId)+'</h2><p>'+label(row.left)+' → '+label(row.right)+'</p><p>原预期：'+esc(row.left?.expected??'无')+'</p><p>本次预期：'+esc(row.right?.expected??'无')+'</p><details><summary>来源、证据与可比性</summary><pre>'+esc(JSON.stringify(row,null,2))+'</pre></details></section>').join('')+'<p>'+esc(comparison.caveat)+'</p></html>\n';
 const files={json:path.join(target,'comparison.json'),markdown:path.join(target,'comparison.md'),html:path.join(target,'comparison.html')};
 try {for(const [file,bytes] of [[files.json,json(comparison)],[files.markdown,markdown],[files.html,html]] as const)owned.push({file,identity:await writeNew(file,bytes)});return{directory:target,...files,contentSha256};}
 catch(caught){const error=errorInfo(caught),cleanup:string[]=[];for(const f of owned.reverse())try{await removeOwnedFileIfPresent(f.file,f.identity);}catch(e){cleanup.push(errorInfo(e).message);}try{const stat=await fs.lstat(target);if(stat.dev!==directoryIdentity.dev||stat.ino!==directoryIdentity.ino||stat.isSymbolicLink())fail('Comparison directory changed; preserving it.');await fs.rmdir(target);}catch(e){cleanup.push(errorInfo(e).message);}if(cleanup.length)error.cleanupError=cleanup.join('; ');throw error;}
}
