{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Ego Lite run manifest v6",
  "type": "object",
  "required": [
    "schemaVersion",
    "baselineSchemaVersion",
    "runId",
    "projectDir",
    "baselineSha256",
    "executionFile"
  ],
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "baselineSchemaVersion": {
      "const": 6
    },
    "runId": {
      "$ref": "common.schema.json#/$defs/nonempty"
    },
    "projectDir": {
      "$ref": "common.schema.json#/$defs/nonempty"
    },
    "baselineSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "executionFile": {
      "const": "execution.json"
    }
  },
  "additionalProperties": false
}
