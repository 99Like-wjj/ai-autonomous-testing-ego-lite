{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ego Lite baseline manifest v2",
  "description": "Generated baseline manifest. The helper additionally checks that projectDir is absolute according to the host platform.",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "baselineSha256",
    "projectDir"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "runId": {
      "type": "string",
      "pattern": "\\S"
    },
    "projectDir": {
      "$ref": "common.schema.json#/$defs/nonempty"
    },
    "baselineSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false,
  "$id": "manifest.schema.json"
}
