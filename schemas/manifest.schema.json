{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Ego Lite run manifest v8",
  "type": "object",
  "required": [
    "schemaVersion",
    "baselineSchemaVersion",
    "runId",
    "projectDir",
    "baselineSha256",
    "executionFile"
  ],
  "properties": {
    "schemaVersion": {
      "const": 8
    },
    "baselineSchemaVersion": {
      "const": 8
    },
    "runId": {
      "$ref": "common.schema.json#/$defs/nonempty"
    },
    "projectDir": {
      "$ref": "common.schema.json#/$defs/nonempty"
    },
    "baselineSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "executionFile": {
      "const": "execution.json"
    },
    "regressionBindingFile": {
      "const": "regression-binding.json"
    },
    "regressionBindingSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "regressionBindingFile"
        ]
      },
      "then": {
        "required": [
          "regressionBindingSha256"
        ]
      }
    },
    {
      "if": {
        "required": [
          "regressionBindingSha256"
        ]
      },
      "then": {
        "required": [
          "regressionBindingFile"
        ]
      }
    }
  ]
}
