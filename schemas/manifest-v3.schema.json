{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest-v3.schema.json",
  "title": "Ego Lite run manifest v3",
  "description": "All new cases and run files use schemaVersion 3. This is a breaking format update with no v0.1.2 migration.",
  "type": "object",
  "required": [
    "schemaVersion",
    "baselineSchemaVersion",
    "runId",
    "projectDir",
    "baselineSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "baselineSchemaVersion": {
      "const": 3
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "projectDir": {
      "$ref": "common.schema.json#/$defs/nonempty"
    },
    "baselineSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}

