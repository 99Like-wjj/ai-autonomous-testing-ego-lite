{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "record-request.schema.json",
  "title": "Result or attempt request v5",
  "type": "object",
  "required": [
    "schemaVersion",
    "operationId",
    "expectedRevision",
    "caseId",
    "mode",
    "record"
  ],
  "properties": {
    "schemaVersion": {
      "const": 5
    },
    "operationId": {
      "$ref": "common.schema.json#/$defs/safeId"
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0
    },
    "caseId": {
      "$ref": "common.schema.json#/$defs/safeId"
    },
    "mode": {
      "enum": [
        "final",
        "attempt"
      ]
    },
    "record": {
      "$ref": "common.schema.json#/$defs/recordPayload"
    }
  },
  "additionalProperties": false
}
