{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "results.schema.json",
  "title": "Ego Lite recorded results v5",
  "type": "object",
  "required": [
    "schemaVersion",
    "revision",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 5
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/resultEntry"
      }
    }
  },
  "additionalProperties": false
}
