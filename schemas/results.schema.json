{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "results.schema.json",
  "title": "Ego Lite recorded results v3",
  "description": "Revisioned final results, explicit attempts, and idempotency receipts. Runtime validation also enforces evidence ownership and the frozen-baseline clarification veto.",
  "type": "object",
  "required": ["schemaVersion", "revision", "cases", "operations"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "revision": { "type": "integer", "minimum": 0 },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/resultV3" } },
    "operations": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/resultOperationV3" } }
  },
  "additionalProperties": false
}
