{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regression-comparison.schema.json",
  "title": "Point comparison request v2",
  "type": "object",
  "properties": {
    "regressionVersion": {
      "const": 2
    },
    "left": {
      "type": "object",
      "properties": {
        "runDir": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "baselineSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "resultsRevision": {
          "type": "integer",
          "minimum": 0
        },
        "resultsSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "runDir",
        "runId",
        "baselineSha256",
        "resultsRevision",
        "resultsSha256"
      ],
      "additionalProperties": false
    },
    "right": {
      "type": "object",
      "properties": {
        "runDir": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "baselineSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "resultsRevision": {
          "type": "integer",
          "minimum": 0
        },
        "resultsSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "runDir",
        "runId",
        "baselineSha256",
        "resultsRevision",
        "resultsSha256"
      ],
      "additionalProperties": false
    },
    "pointIds": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/safeId"
      }
    },
    "comparability": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pointId": {
            "$ref": "common.schema.json#/$defs/safeId"
          },
          "state": {
            "enum": [
              "comparable",
              "limited",
              "not_directly_comparable"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "side": {
                  "enum": [
                    "left",
                    "right"
                  ]
                },
                "kind": {
                  "enum": [
                    "result",
                    "evidence",
                    "binding"
                  ]
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "side",
                "kind",
                "ref"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "pointId",
          "state",
          "rationale",
          "sources"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "regressionVersion",
    "left",
    "right"
  ],
  "additionalProperties": false
}
