{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cases.schema.json",
  "title": "Ego Lite case input and normalized baseline v7",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "project": {
      "$ref": "common.schema.json#/$defs/nonempty"
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/case"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
