      "type": "object",
      "properties": {
        "ruleId": {
          "$ref": "common.schema.json#/$defs/safeId"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "contentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "ruleId",
        "revision",
        "contentSha256"
      ],
      "additionalProperties": false
    },
    "taskRef": {
      "type": "object",
      "properties": {
