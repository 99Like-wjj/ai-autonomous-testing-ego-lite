{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regression-artifact.schema.json",
  "title": "Immutable regression artifact and commit request v1",
  "description": "Normative sources and historical facts remain separate. Structural validity is not current readiness or product quality. Runtime checks verify exact references, hashes and revision history.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/storedRule"
    },
    {
      "$ref": "#/$defs/storedTask"
    }
  ],
