{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regression-selection.schema.json",
  "title": "Regression selection request v2",
  "type": "object",
  "properties": {
    "regressionVersion": {
      "const": 2
    },
    "casesFile": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "$ref": "common.schema.json#/$defs/casesRef"
    },
    "mode": {
      "enum": [
        "points",
        "status",
        "full"
      ]
    },
    "pointIds": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/safeId"
      },
      "uniqueItems": true
    },
    "sourceRun": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "runDir": {
              "type": "string",
              "minLength": 1
            },
            "runId": {
              "type": "string",
              "minLength": 1
            },
            "baselineSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "resultsRevision": {
              "type": "integer",
              "minimum": 0
            },
            "resultsSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "runDir",
            "runId",
            "baselineSha256",
            "resultsRevision",
            "resultsSha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "statuses": {
      "type": "array",
      "items": {
        "enum": [
          "verified",
          "violation",
          "inconclusive",
          "not_tested"
        ]
      },
      "uniqueItems": true
    },
    "includeUnassessedCases": {
      "type": "boolean"
    }
  },
  "required": [
    "regressionVersion",
    "casesFile",
    "cases",
    "mode",
    "pointIds",
    "sourceRun",
    "statuses",
    "includeUnassessedCases"
  ],
  "additionalProperties": false,
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "regressionVersion": {
          "const": 2
        },
        "casesFile": {
          "type": "string",
          "minLength": 1
        },
        "cases": {
          "$ref": "common.schema.json#/$defs/casesRef"
        },
        "mode": {
          "enum": [
            "points",
            "status",
            "full"
          ]
        },
        "pointIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/safeId"
          },
          "uniqueItems": true
        },
        "sourceRun": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "runDir": {
                  "type": "string",
                  "minLength": 1
                },
                "runId": {
                  "type": "string",
                  "minLength": 1
                },
                "baselineSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "resultsRevision": {
                  "type": "integer",
                  "minimum": 0
                },
                "resultsSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "runDir",
                "runId",
                "baselineSha256",
                "resultsRevision",
                "resultsSha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "statuses": {
          "type": "array",
          "items": {
            "enum": [
              "verified",
              "violation",
              "inconclusive",
              "not_tested"
            ]
          },
          "uniqueItems": true
        },
        "includeUnassessedCases": {
          "type": "boolean"
        }
      },
      "required": [
        "regressionVersion",
        "casesFile",
        "cases",
        "mode",
        "pointIds",
        "sourceRun",
        "statuses",
        "includeUnassessedCases"
      ],
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {
        "regressionVersion": {
          "const": 2
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "selectedPointIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/safeId"
          }
        },
        "matchedPointIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/safeId"
          }
        },
        "notSelectedPointIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/safeId"
          }
        },
        "sourceStates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pointId": {
                "$ref": "common.schema.json#/$defs/safeId"
              },
              "status": {
                "anyOf": [
                  {
                    "enum": [
                      "verified",
                      "violation",
                      "inconclusive",
                      "not_tested"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "inSourceScope": {
                "type": "boolean"
              }
            },
            "required": [
              "pointId",
              "status",
              "inSourceScope"
            ],
            "additionalProperties": false
          }
        },
        "candidatePlans": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "caseId": {
                "$ref": "common.schema.json#/$defs/safeId"
              },
              "pointIds": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/safeId"
                }
              },
              "conditionIds": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/safeId"
                }
              },
              "stepIds": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/safeId"
                }
              },
              "includeRequiredPath": {
                "type": "boolean"
              }
            },
            "required": [
              "caseId",
              "pointIds",
              "conditionIds",
              "stepIds",
              "includeRequiredPath"
            ],
            "additionalProperties": false
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pointId": {
                "anyOf": [
                  {
                    "$ref": "common.schema.json#/$defs/safeId"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sourceInventoryId": {
                "anyOf": [
                  {
                    "$ref": "common.schema.json#/$defs/safeId"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "code": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "pointId",
              "sourceInventoryId",
              "code",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "selectionSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "regressionVersion",
        "request",
        "selectedPointIds",
        "matchedPointIds",
        "notSelectedPointIds",
        "sourceStates",
        "candidatePlans",
        "gaps",
        "selectionSha256"
      ],
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "caseId": {
          "$ref": "common.schema.json#/$defs/safeId"
        },
        "pointIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/safeId"
          }
        },
        "conditionIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/safeId"
          }
        },
        "stepIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/safeId"
          }
        },
        "includeRequiredPath": {
          "type": "boolean"
        }
      },
      "required": [
        "caseId",
        "pointIds",
        "conditionIds",
        "stepIds",
        "includeRequiredPath"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "runDir": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "baselineSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "resultsRevision": {
          "type": "integer",
          "minimum": 0
        },
        "resultsSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "runDir",
        "runId",
        "baselineSha256",
        "resultsRevision",
        "resultsSha256"
      ],
      "additionalProperties": false
    }
  }
}
