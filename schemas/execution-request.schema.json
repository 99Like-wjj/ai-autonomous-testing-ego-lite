{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-request.schema.json",
  "title": "Ego Lite execution request v1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "operationId": {
          "$ref": "common.schema.json#/$defs/safeId"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "$ref": "common.schema.json#/$defs/nonempty"
        },
        "kind": {
          "const": "inventory"
        },
        "spaceIds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "uniqueItems": true
        },
        "evidenceFiles": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/nonempty"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "operationId",
        "expectedRevision",
        "reason",
        "kind",
        "spaceIds"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "operationId": {
          "$ref": "common.schema.json#/$defs/safeId"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "$ref": "common.schema.json#/$defs/nonempty"
        },
        "kind": {
          "const": "capacity"
        },
        "availableWorkers": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceFiles": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/nonempty"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "operationId",
        "expectedRevision",
        "reason",
        "kind",
        "availableWorkers"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "operationId": {
          "$ref": "common.schema.json#/$defs/safeId"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "$ref": "common.schema.json#/$defs/nonempty"
        },
        "kind": {
          "const": "reserve"
        },
        "caseId": {
          "$ref": "common.schema.json#/$defs/safeId"
        },
        "baselineSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/nonempty"
          },
          "uniqueItems": true
        },
        "workerId": {
          "$ref": "common.schema.json#/$defs/nonempty"
        },
        "model": {
          "$ref": "common.schema.json#/$defs/nonempty"
        },
        "reasoning": {
          "$ref": "common.schema.json#/$defs/nonempty"
        }
      },
      "required": [
        "schemaVersion",
        "operationId",
        "expectedRevision",
        "reason",
        "kind",
        "caseId",
        "baselineSha256"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "operationId": {
          "$ref": "common.schema.json#/$defs/safeId"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "$ref": "common.schema.json#/$defs/nonempty"
        },
        "kind": {
          "const": "attach-space"
        },
        "assignmentId": {
          "$ref": "common.schema.json#/$defs/safeId"
        },
        "spaceId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "name": {
          "$ref": "common.schema.json#/$defs/nonempty"
        },
        "receiptFile": {
          "$ref": "common.schema.json#/$defs/nonempty"
        },
        "created": {
          "const": true
        },
        "replaceDefault": {
          "type": "boolean"
        }
      },
      "required": [
        "schemaVersion",
        "operationId",
        "expectedRevision",
        "reason",
        "kind",
        "assignmentId",
        "spaceId",
        "name",
        "receiptFile",
        "created"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "operationId": {
          "$ref": "common.schema.json#/$defs/safeId"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "$ref": "common.schema.json#/$defs/nonempty"
        },
        "kind": {
          "const": "note"
        },
        "assignmentId": {
          "$ref": "common.schema.json#/$defs/safeId"
        },
        "category": {
          "enum": [
            "observation",
            "space-deviation",
            "skill-bug",
            "external-change",
            "cleanup"
          ]
        },
        "spaceIds": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "remainingSpaceIds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "uniqueItems": true
        },
        "evidenceFiles": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/nonempty"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "operationId",
        "expectedRevision",
        "reason",
        "kind",
        "category"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "operationId": {
          "$ref": "common.schema.json#/$defs/safeId"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "$ref": "common.schema.json#/$defs/nonempty"
        },
        "kind": {
          "const": "set-limit"
        },
        "maxParallelCases": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schemaVersion",
        "operationId",
        "expectedRevision",
        "reason",
        "kind",
        "maxParallelCases"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "operationId": {
          "$ref": "common.schema.json#/$defs/safeId"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "$ref": "common.schema.json#/$defs/nonempty"
        },
        "kind": {
          "const": "reconcile"
        },
        "assignmentId": {
          "$ref": "common.schema.json#/$defs/safeId"
        },
        "state": {
          "enum": [
            "running",
            "paused",
            "stop_requested",
            "stopped",
            "completed",
            "failed",
            "lost"
          ]
        },
        "inFlight": {
          "type": "boolean"
        },
        "workerId": {
          "$ref": "common.schema.json#/$defs/nonempty"
        },
        "model": {
          "$ref": "common.schema.json#/$defs/nonempty"
        },
        "reasoning": {
          "$ref": "common.schema.json#/$defs/nonempty"
        },
        "evidenceFiles": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/nonempty"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "operationId",
        "expectedRevision",
        "reason",
        "kind",
        "assignmentId",
        "state",
        "inFlight"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "operationId": {
          "$ref": "common.schema.json#/$defs/safeId"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "$ref": "common.schema.json#/$defs/nonempty"
        },
        "kind": {
          "const": "import"
        },
        "packetFile": {
          "$ref": "common.schema.json#/$defs/nonempty"
        },
        "review": {
          "title": "Packet review",
          "type": "object",
          "properties": {
            "decision": {
              "enum": [
                "accept",
                "revise"
              ]
            },
            "reviewer": {
              "$ref": "common.schema.json#/$defs/nonempty"
            },
            "rationale": {
              "$ref": "common.schema.json#/$defs/nonempty"
            },
            "record": {
              "$ref": "worker-packet.schema.json#/$defs/record"
            },
            "goalAssessments": {
              "type": "array",
              "items": {
                "$ref": "worker-packet.schema.json#/$defs/goal"
              },
              "minItems": 1
            },
            "mode": {
              "enum": [
                "attempt",
                "final"
              ]
            }
          },
          "required": [
            "decision",
            "reviewer",
            "rationale"
          ],
          "additionalProperties": false
        },
        "rebaseOf": {
          "$ref": "common.schema.json#/$defs/safeId"
        }
      },
      "required": [
        "schemaVersion",
        "operationId",
        "expectedRevision",
        "reason",
        "kind",
        "packetFile",
        "review"
      ],
      "additionalProperties": false
    }
  ]
}

