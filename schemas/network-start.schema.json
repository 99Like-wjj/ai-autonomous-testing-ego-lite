{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Network start v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "networkVersion",
    "spaceId",
    "pages",
    "interfaces"
  ],
  "properties": {
    "networkVersion": {
      "const": 1
    },
    "spaceId": {
      "type": "integer",
      "minimum": 0
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "targetId",
          "origins"
        ],
        "properties": {
          "label": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "targetId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          },
          "origins": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "description": "Exact authorized HTTP(S) origin, no path, credentials, query or fragment."
            }
          }
        }
      }
    },
    "interfaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "origin",
          "pathPrefixes"
        ],
        "properties": {
          "origin": {
            "type": "string"
          },
          "pathPrefixes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "description": "Absolute path prefix with a segment boundary; /api also matches /api/items but not /api2."
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bodies": {
          "enum": [
            "redact",
            "omit"
          ],
          "default": "redact"
        },
        "jsonFields": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          ],
          "default": null,
          "description": "Explicit dotted allowed JSON fields. Non-JSON content is omitted when this list is used. Sensitive and prototype fields are forbidden."
        },
        "headers": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "Allowed necessary response/request headers; credential headers are always forbidden."
        },
        "wsBinary": {
          "enum": [
            "include",
            "omit"
          ],
          "default": "include",
          "description": "Opaque binary cannot be generically redacted; use omit for strict content policies."
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxBodyBytes": {
          "type": "integer",
          "minimum": 256,
          "maximum": 8388608,
          "default": 524288
        },
        "maxDiskBytes": {
          "type": "integer",
          "minimum": 32768,
          "maximum": 1073741824,
          "default": 67108864,
          "description": "Run capture budget including earlier captures. History is never rotated/deleted."
        },
        "maxQueueEvents": {
          "type": "integer",
          "minimum": 4,
          "maximum": 65536,
          "default": 4096
        },
        "maxQueueBytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 67108864,
          "default": 8388608
        },
        "maxTrackedRequests": {
          "type": "integer",
          "minimum": 4,
          "maximum": 65536,
          "default": 4096
        },
        "maxQueryBytes": {
          "type": "integer",
          "minimum": 8192,
          "maximum": 2097152,
          "default": 262144
        },
        "pollMs": {
          "type": "integer",
          "minimum": 25,
          "maximum": 2000,
          "default": 100
        },
        "commandTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000,
          "default": 5000
        },
        "startupTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000,
          "default": 15000
        }
      }
    }
  }
}
