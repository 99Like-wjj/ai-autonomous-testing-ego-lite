{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report-context.schema.json",
  "title": "Retrospective report context v9, no business execution",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "summary",
    "limitations",
    "sources",
    "supplementalCaseIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": 9
    },
    "kind": {
      "const": "retrospective"
    },
    "summary": {
      "$ref": "common.schema.json#/$defs/nonempty"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/nonempty"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "label",
          "file",
          "sha256"
        ],
        "properties": {
          "label": {
            "$ref": "common.schema.json#/$defs/nonempty"
          },
          "file": {
            "$ref": "common.schema.json#/$defs/nonempty"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "readerNotes": {
      "description": "AI-authored display notes bound to existing goal observations and actual actions. Never new execution, verdicts or plan-derived steps.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "caseId",
          "goalId",
          "title",
          "description",
          "actions",
          "sourceLabels",
          "limitations"
        ],
        "properties": {
          "caseId": {
            "$ref": "common.schema.json#/$defs/safeId"
          },
          "goalId": {
            "$ref": "common.schema.json#/$defs/safeId"
          },
          "title": {
            "$ref": "common.schema.json#/$defs/nonempty"
          },
          "description": {
            "$ref": "common.schema.json#/$defs/nonempty"
          },
          "focusAction": {
            "$ref": "#/$defs/actionRef"
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "observationId",
                "actionId",
                "title",
                "evidenceIds"
              ],
              "properties": {
                "observationId": {
                  "$ref": "common.schema.json#/$defs/safeId"
                },
                "actionId": {
                  "$ref": "common.schema.json#/$defs/safeId"
                },
                "title": {
                  "$ref": "common.schema.json#/$defs/nonempty"
                },
                "result": {
                  "$ref": "common.schema.json#/$defs/nonempty"
                },
                "note": {
                  "$ref": "common.schema.json#/$defs/nonempty"
                },
                "evidenceIds": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "$ref": "common.schema.json#/$defs/safeId"
                  }
                },
                "inputSummary": {
                  "type": "string",
                  "minLength": 1
                },
                "replySummary": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "sourceLabels": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "common.schema.json#/$defs/nonempty"
            }
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.schema.json#/$defs/nonempty"
            }
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "dimension": {
            "enum": [
              "business",
              "interaction",
              "wording",
              "content",
              "presentation"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "goalNotes": {
      "description": "AI-authored retrospective reading notes. They cannot override verdicts or claim new execution.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "caseId",
          "goalId",
          "summary",
          "preparation",
          "reviewSteps",
          "limitations",
          "sourceLabels",
          "primaryEvidenceIds",
          "evidenceUses"
        ],
        "properties": {
          "caseId": {
            "$ref": "common.schema.json#/$defs/safeId"
          },
          "goalId": {
            "$ref": "common.schema.json#/$defs/safeId"
          },
          "summary": {
            "$ref": "common.schema.json#/$defs/nonempty"
          },
          "preparation": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/nonempty"
            }
          },
          "reviewSteps": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/nonempty"
            }
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.schema.json#/$defs/nonempty"
            }
          },
          "sourceLabels": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "common.schema.json#/$defs/nonempty"
            }
          },
          "primaryEvidenceIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "common.schema.json#/$defs/safeId"
            }
          },
          "evidenceUses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "evidenceId",
                "purpose",
                "fact",
                "limitations"
              ],
              "properties": {
                "evidenceId": {
                  "$ref": "common.schema.json#/$defs/safeId"
                },
                "purpose": {
                  "$ref": "common.schema.json#/$defs/nonempty"
                },
                "fact": {
                  "$ref": "common.schema.json#/$defs/nonempty"
                },
                "limitations": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/nonempty"
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "supplementalCaseIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/nonempty"
      }
    },
    "conversations": {
      "type": "array",
      "items": {
        "title": "Reading conversation declaration",
        "type": "object",
        "properties": {
          "caseId": {
            "$ref": "common.schema.json#/$defs/safeId"
          },
          "goalId": {
            "$ref": "common.schema.json#/$defs/safeId"
          },
          "sourceLabel": {
            "type": "string",
            "minLength": 1
          },
          "sourceBindings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "title": "Reading conversation source binding",
              "type": "object",
              "properties": {
                "sourceId": {
                  "$ref": "common.schema.json#/$defs/safeId"
                },
                "evidenceId": {
                  "$ref": "common.schema.json#/$defs/safeId"
                },
                "sourceLabel": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "sourceId"
              ],
              "additionalProperties": false,
              "oneOf": [
                {
                  "required": [
                    "evidenceId"
                  ],
                  "not": {
                    "required": [
                      "sourceLabel"
                    ]
                  }
                },
                {
                  "required": [
                    "sourceLabel"
                  ],
                  "not": {
                    "required": [
                      "evidenceId"
                    ]
                  }
                }
              ]
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "title": "Reading conversation action binding",
              "type": "object",
              "properties": {
                "observationId": {
                  "$ref": "common.schema.json#/$defs/safeId"
                },
                "actionId": {
                  "$ref": "common.schema.json#/$defs/safeId"
                },
                "messageIds": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/safeId"
                  },
                  "uniqueItems": true,
                  "minItems": 1
                }
              },
              "required": [
                "observationId",
                "actionId",
                "messageIds"
              ],
              "additionalProperties": false
            }
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "caseId",
          "goalId",
          "sourceLabel",
          "sourceBindings",
          "actions",
          "limitations"
        ],
        "additionalProperties": false
      }
    },
    "aiContext": {
      "$ref": "common.schema.json#/$defs/aiContext"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "actionRef": {
      "type": "object",
      "required": [
        "observationId",
        "actionId"
      ],
      "properties": {
        "observationId": {
          "$ref": "common.schema.json#/$defs/safeId"
        },
        "actionId": {
          "$ref": "common.schema.json#/$defs/safeId"
        }
      },
      "additionalProperties": false
    }
  }
}
