{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worker-packet.schema.json",
  "title": "Ego Lite worker packet v6",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "baselineSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "caseId": {
      "$ref": "common.schema.json#/$defs/safeId"
    },
    "assignmentId": {
      "$ref": "common.schema.json#/$defs/safeId"
    },
    "attemptId": {
      "$ref": "common.schema.json#/$defs/safeId"
    },
    "packetId": {
      "$ref": "common.schema.json#/$defs/safeId"
    },
    "mode": {
      "enum": [
        "attempt",
        "final"
      ]
    },
    "record": {
      "$ref": "#/$defs/record"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "executionWindow": {
      "$ref": "#/$defs/window"
    },
    "spaceUsage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "spaceId",
          "reason",
          "evidenceKeys"
        ],
        "properties": {
          "spaceId": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string",
            "pattern": "\\S"
          },
          "evidenceKeys": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "common.schema.json#/$defs/safeId"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "baselineSha256",
    "caseId",
    "assignmentId",
    "attemptId",
    "packetId",
    "mode",
    "record",
    "evidence",
    "spaceUsage"
  ],
  "additionalProperties": false,
  "$defs": {
    "record": {
      "$ref": "common.schema.json#/$defs/recordPayload"
    },
    "evidence": {
      "title": "Packet evidence",
      "type": "object",
      "properties": {
        "key": {
          "$ref": "common.schema.json#/$defs/safeId"
        },
        "path": {
          "$ref": "common.schema.json#/$defs/nonempty"
        },
        "kind": {
          "enum": [
            "screenshot",
            "dom",
            "tool_receipt",
            "log",
            "other"
          ]
        },
        "source": {
          "$ref": "common.schema.json#/$defs/nonempty"
        },
        "description": {
          "$ref": "common.schema.json#/$defs/nonempty"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "capturedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "metadata": {
          "$ref": "common.schema.json#/$defs/evidenceMetadata"
        }
      },
      "required": [
        "key",
        "path",
        "kind",
        "source",
        "description",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false
    },
    "window": {
      "title": "Execution window",
      "type": "object",
      "properties": {
        "startedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "endedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "evidenceKeys": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/safeId"
          },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "required": [
        "startedAt",
        "endedAt",
        "evidenceKeys"
      ],
      "additionalProperties": false
    }
  }
}
