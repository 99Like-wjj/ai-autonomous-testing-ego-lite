{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-request.schema.json",
  "title": "Evidence registration request v7",
  "type": "object",
  "required": [
    "schemaVersion",
    "operationId",
    "expectedRevision",
    "caseId",
    "sourceFile",
    "kind",
    "source",
    "description"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operationId": {
      "$ref": "common.schema.json#/$defs/safeId"
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0
    },
    "caseId": {
      "$ref": "common.schema.json#/$defs/safeId"
    },
    "sourceFile": {
      "$ref": "common.schema.json#/$defs/nonempty"
    },
    "kind": {
      "enum": [
        "screenshot",
        "dom",
        "tool_receipt",
        "log",
        "other"
      ]
    },
    "capturedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/nonempty",
      "maxLength": 4096
    },
    "description": {
      "$ref": "common.schema.json#/$defs/nonempty",
      "maxLength": 4096
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/evidenceMetadata"
    }
  },
  "additionalProperties": false
}
