{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regression-binding.schema.json",
  "title": "Run binding request v2",
  "type": "object",
  "properties": {
    "regressionVersion": {
      "const": 2
    },
    "selection": {
      "$ref": "regression-selection.schema.json#/$defs/selection"
    },
    "reviewFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "plans": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "caseId": {
            "$ref": "common.schema.json#/$defs/safeId"
          },
          "pointIds": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/safeId"
            }
          },
          "conditionIds": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/safeId"
            }
          },
          "stepIds": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/safeId"
            }
          },
          "includeRequiredPath": {
            "type": "boolean"
          }
        },
        "required": [
          "caseId",
          "pointIds"
        ],
        "additionalProperties": false
      }
    },
    "deferred": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pointId": {
            "$ref": "common.schema.json#/$defs/safeId"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "pointId",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "parameterBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "caseId": {
            "$ref": "common.schema.json#/$defs/safeId"
          },
          "parameterId": {
            "$ref": "common.schema.json#/$defs/safeId"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "label"
                ],
                "additionalProperties": false
              }
            ]
          },
          "source": {
            "$ref": "common.schema.json#/$defs/sourceRef"
          }
        },
        "required": [
          "caseId",
          "parameterId",
          "value",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "currentConditions": {
      "type": "object",
      "properties": {
        "declaredBy": {
          "type": "string",
          "minLength": 1
        },
        "declaredAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "forCurrentRun": {
          "const": true
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/safeId"
              },
              "caseIds": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/safeId"
                }
              },
              "aspect": {
                "enum": [
                  "identity",
                  "environment",
                  "data",
                  "authorization",
                  "path",
                  "other"
                ]
              },
              "state": {
                "enum": [
                  "verified",
                  "pending",
                  "deferred"
                ]
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "ai_declaration",
                      "current_user_statement",
                      "current_evidence"
                    ]
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1
                  },
                  "file": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sha256": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "locator",
                  "file",
                  "sha256"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "caseIds",
              "aspect",
              "state",
              "statement",
              "source"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "declaredBy",
        "declaredAt",
        "forCurrentRun",
        "items"
      ],
      "additionalProperties": false
    },
    "history": {
      "type": "object",
      "properties": {
        "parents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "runDir": {
                "type": "string",
                "minLength": 1
              },
              "runId": {
                "type": "string",
                "minLength": 1
              },
              "baselineSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "resultsRevision": {
                "type": "integer",
                "minimum": 0
              },
              "resultsSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "runDir",
              "runId",
              "baselineSha256",
              "resultsRevision",
              "resultsSha256"
            ],
            "additionalProperties": false
          }
        },
        "primaryBaseline": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "runDir": {
                  "type": "string",
                  "minLength": 1
                },
                "runId": {
                  "type": "string",
                  "minLength": 1
                },
                "baselineSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "resultsRevision": {
                  "type": "integer",
                  "minimum": 0
                },
                "resultsSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "runDir",
                "runId",
                "baselineSha256",
                "resultsRevision",
                "resultsSha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "parents",
        "primaryBaseline",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "regressionVersion",
    "selection",
    "reviewFiles",
    "plans",
    "deferred",
    "parameterBindings",
    "currentConditions",
    "history"
  ],
  "additionalProperties": false
}
