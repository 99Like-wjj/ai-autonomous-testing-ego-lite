{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence.schema.json",
  "title": "Ego Lite evidence catalog v6",
  "type": "object",
  "required": [
    "schemaVersion",
    "revision",
    "items",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/evidenceItem"
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/evidenceOperation"
      }
    }
  },
  "additionalProperties": false
}
