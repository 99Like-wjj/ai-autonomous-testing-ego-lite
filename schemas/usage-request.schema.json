{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "usage-request.schema.json",
  "title": "Explicit usage input request",
  "type": "object",
  "required": [
    "inputFile"
  ],
  "properties": {
    "inputFile": {
      "type": "string"
    },
    "groupLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "additionalProperties": false
}
