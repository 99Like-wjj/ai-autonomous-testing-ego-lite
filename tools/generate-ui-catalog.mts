/** Extract only explicitly marked source UI fragments, never user data or evidence. */
import fs from 'node:fs/promises';
import path from 'node:path';
import ts from 'typescript';
import { uiSegments } from '../src/report/ui-text.mjs';

const root = path.resolve(process.cwd());
const files = ['src/report/ui-text.mts', 'src/report/render.mts', 'src/report/shell.mts', 'src/report/case-reader.mts', 'src/report/case-reader-shell.mts', 'src/report/review-feedback-document.mts', 'src/review-ui/save-file.mts', 'src/report/reviewability.mts', 'src/report/assets.mts', 'src/report/conversations.mts', 'src/report/history.mts', 'src/contracts/case-view.mts', 'src/report-ui/main.ts', 'src/report-ui/conversations.ts', 'src/review-ui/app.ts', 'src/report/model-display.mts', 'src/report/scope-label.mts'];
const keys = new Set<string>();
const add = (value: string) => { for (const key of uiSegments(value)) keys.add(key); };
for (const file of files) {
  const source = await fs.readFile(path.join(root, file), 'utf8');
  const tree = ts.createSourceFile(file, source, ts.ScriptTarget.Latest, true);
  const visit = (n: ts.Node): void => {
    if (ts.isCallExpression(n) && ts.isIdentifier(n.expression) && ['u', 'uiText', 'uiMarkup'].includes(n.expression.text)) {
      const a = n.arguments[0]; if (a && (ts.isStringLiteral(a) || ts.isNoSubstitutionTemplateLiteral(a))) add(a.text);
    }
    if(ts.isCallExpression(n)&&ts.isIdentifier(n.expression)&&n.expression.text==='formatUi'){const a=n.arguments[0];if(a&&ts.isStringLiteral(a))keys.add(a.text);}
    if (ts.isTaggedTemplateExpression(n) && ts.isIdentifier(n.tag) && ['uiHtml', 'uiTemplate'].includes(n.tag.text)) {
      if (ts.isNoSubstitutionTemplateLiteral(n.template)) add(n.template.text);
      else { add(n.template.head.text); for (const span of n.template.templateSpans) add(span.literal.text); }
    }
    ts.forEachChild(n, visit);
  };
  visit(tree);
}
// These source-defined theme/assessment names are looked up dynamically by the UI.
for (const file of ['src/report/themes.mts', 'src/report/execution-view.mts']) {
  const source = ts.createSourceFile(file, await fs.readFile(path.join(root, file), 'utf8'), ts.ScriptTarget.Latest, true);
  const visit = (n: ts.Node): void => { if (ts.isStringLiteral(n)) add(n.text); ts.forEachChild(n, visit); }; visit(source);
}
const sorted = [...keys].sort();
const text = '/** Generated by tools/generate-ui-catalog.mts. Source UI keys only. */\nexport const uiMessageKeys: readonly string[] = ' + JSON.stringify(sorted, null, 2) + ';\n';
const target = path.join(root, 'src/report/ui-catalog.mts');
if (process.argv.includes('--check')) {
  if (await fs.readFile(target, 'utf8') !== text) throw Error('UI catalog is stale; run npm run ui:write.');
} else await fs.writeFile(target, text);
process.stdout.write('UI catalog: ' + sorted.length + ' source fragments.\n');
