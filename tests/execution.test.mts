import test, { type TestContext } from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import os from 'node:os';
import path from 'node:path';
import type { Baseline, RecordPayload } from '../src/contracts/model.mjs';
import { start } from '../src/core/cases.mjs';
import { check, recordResult, registerEvidence } from '../src/core/records.mjs';
import { executeRequest, readExecutionView, readExecutionQuery } from '../src/execution/commands.mjs';
import { sealPacket } from '../src/execution/packets.mjs';
import { report, verifyReport } from '../src/report/delivery.mjs';
import { at } from './support.mjs';

async function fixture(t: TestContext, limit=1) {
 const root=await fs.mkdtemp(path.join(os.tmpdir(),'ego-goal-execution-'));
 t.after(async()=>{assert.equal(path.dirname(root),path.resolve(os.tmpdir()));assert.ok(path.basename(root).startsWith('ego-goal-execution-'));await fs.rm(root,{recursive:true,force:true});});
 const project=path.join(root,'project'),run=path.join(root,'run');await fs.mkdir(project);
 const baseline:Baseline={schemaVersion:7,project:'Synthetic execution',cases:Array.from({length:14},(_,i)=>({id:'case-'+i,title:'Synthetic '+i,criticalConditions:['Synthetic only'],requiredPath:null,stepOrder:'strict',steps:[{id:'read',action:'Read synthetic value'}],goals:[{id:'value',title:'Saved value readback',basis:{kind:'explicit',source:'Synthetic requirement',text:'Value visible'},expected:'Value visible',requiredRefs:['condition:0','step:read']},{id:'permission',title:'Other role access',basis:{kind:'explicit',source:'Synthetic requirement',text:'Other role rejected'},expected:'Other role rejected',requiredRefs:['condition:0','step:read']}]}))};
 const casesFile=path.join(project,'cases.json');await fs.writeFile(casesFile,JSON.stringify(baseline));await start({projectDir:project,casesFile,outputDir:run,maxParallelCases:limit});let n=0;
 const request=async(kind:string,extra:Record<string,unknown>={})=>executeRequest({runDir:run,request:{schemaVersion:7,operationId:'exec-'+(++n),expectedRevision:(await readExecutionView(run)).revision,kind,reason:'Synthetic fact',...extra}});
 const reserve=async(caseId='case-0',resources:string[]=[])=>{const s=await readExecutionView(run);const x=await request('reserve',{caseId,baselineSha256:s.baselineSha256,resources});assert.ok(x.assignmentId);return x.assignmentId;};
 const payload=(evidenceId='shot'):RecordPayload=>({observations:[{id:'read-1',summary:'Synthetic value read back',coveredRefs:['condition:0','step:read'],evidenceIds:[evidenceId]}],assessments:[{goalId:'value',status:'verified',rationale:'Observed expected value',observationIds:['read-1'],gaps:[]},{goalId:'permission',status:'not_tested',rationale:'Second identity deferred',observationIds:[],gaps:['Second identity']}]});
 const packet=async(a:string)=>{const dir=path.join(run,'workers',a);await fs.writeFile(path.join(dir,'shot.txt'),'synthetic');const draft=path.join(dir,'draft.json');await fs.writeFile(draft,JSON.stringify({schemaVersion:7,packetId:'packet-'+n,mode:'final',record:payload(),evidence:[{key:'shot',path:'shot.txt',kind:'log',source:'Synthetic fixture',description:'Readback'}],spaceUsage:[{spaceId:null,reason:'No browser in transaction test',evidenceKeys:[]}]}));return sealPacket({runDir:run,assignment:a,draftFile:draft});};
 const imported=(packetFile:string,extra:Record<string,unknown>={})=>request('import',{packetFile,review:{decision:'accept',reviewer:'Synthetic AI',rationale:'Explicit review'},...extra});
 return {root,run,request,reserve,payload,packet,imported};
}
test('default serial capacity and unsupported old requests',async t=>{const f=await fixture(t);await f.request('inventory',{spaceIds:[]});await f.reserve();await assert.rejects(f.reserve('case-1'),/slot/);await assert.rejects(executeRequest({runDir:f.run,request:{schemaVersion:1}}),/schemaVersion 7/);});
test('known capacity does not rewrite configured maximum or allocate unused slots',async t=>{const f=await fixture(t,12);await f.request('inventory',{spaceIds:[]});await f.request('capacity',{availableWorkers:2});await f.reserve();await f.reserve('case-1');await assert.rejects(f.reserve('case-2'),/slot/);const s=await readExecutionView(f.run);assert.equal(s.configuration.requestedMaxParallelCases,12);assert.equal(s.assignments.length,2);});
test('lowered limit drains work; lost and stop-requested retain reservations',async t=>{const f=await fixture(t,3);await f.request('inventory',{spaceIds:[]});const a=await f.reserve();await f.reserve('case-1');await f.request('set-limit',{maxParallelCases:1});assert.equal((await readExecutionView(f.run)).summary.draining,true);await f.request('reconcile',{assignmentId:a,state:'lost',inFlight:true});await assert.rejects(f.reserve('case-2'),/slot/);await assert.rejects(f.request('reconcile',{assignmentId:a,state:'completed',inFlight:true}),/in.flight/);});
test('resource and same-case conflicts remain guarded',async t=>{const f=await fixture(t,3);await f.request('inventory',{spaceIds:[]});await f.reserve('case-0',['shared']);await assert.rejects(f.reserve(),/active assignment/);await assert.rejects(f.reserve('case-1',['shared']),/resource/);await f.reserve('case-1',['independent']);});
test('execution request idempotency and stale revisions',async t=>{const f=await fixture(t);const request={schemaVersion:7,operationId:'once',expectedRevision:0,kind:'inventory',reason:'Synthetic inventory',spaceIds:[]};await executeRequest({runDir:f.run,request});assert.equal((await executeRequest({runDir:f.run,request})).replayed,true);await assert.rejects(executeRequest({runDir:f.run,request:{...request,reason:'Changed'}}),/different payload/);await assert.rejects(executeRequest({runDir:f.run,request:{...request,operationId:'twice'}}),/revision conflict/);});
test('protected and cross-assignment Spaces cannot be claimed',async t=>{const f=await fixture(t,2);await f.request('inventory',{spaceIds:[9]});const a=await f.reserve(),b=await f.reserve('case-1');const receiptFile=path.join(f.run,'workers',a,'space.json');await fs.writeFile(receiptFile,'{}');await assert.rejects(f.request('attach-space',{assignmentId:a,spaceId:9,name:'Protected',created:true,receiptFile}),/Protected/);await f.request('attach-space',{assignmentId:a,spaceId:20,name:'Owned',created:true,receiptFile});await assert.rejects(f.request('attach-space',{assignmentId:b,spaceId:20,name:'Other',created:true,receiptFile}),/different case/);});
test('seal is local; import commits business goals once to the unified store',async t=>{const f=await fixture(t);await f.request('inventory',{spaceIds:[]});const p=await f.packet(await f.reserve());assert.equal((await check(f.run)).counts.unassessed,28);await f.imported(p.packetFile);const c=await check(f.run);assert.deepEqual(c.counts,{verified:1,violation:0,inconclusive:0,not_tested:1,unassessed:26});assert.equal('goalAssessments' in at((await readExecutionView(f.run)).assignments),false);});
test('changed packet evidence fails without manufacturing assessments',async t=>{const f=await fixture(t);await f.request('inventory',{spaceIds:[]});const a=await f.reserve(),p=await f.packet(a);await fs.writeFile(path.join(f.run,'workers',a,'shot.txt'),'changed');await assert.rejects(f.imported(p.packetFile),/evidence changed/);assert.equal((await check(f.run)).counts.verified,0);});
test('serial and parallel submissions share goal results and report verification',async t=>{const f=await fixture(t,2);await f.request('inventory',{spaceIds:[]});await f.imported((await f.packet(await f.reserve())).packetFile);const sourceFile=path.join(f.root,'direct.txt');await fs.writeFile(sourceFile,'synthetic');const ev=await registerEvidence({runDir:f.run,request:{schemaVersion:7,operationId:'direct-ev',expectedRevision:(await check(f.run)).evidenceRevision,caseId:'case-1',sourceFile,kind:'log',source:'Synthetic fixture',description:'Readback'}});await recordResult({runDir:f.run,request:{schemaVersion:7,operationId:'direct',expectedRevision:(await check(f.run)).revision,caseId:'case-1',mode:'final',record:f.payload(ev.evidenceId)}});const c=(await check(f.run)).cases;assert.deepEqual(at(c).assessments.map(a=>[a.goalId,a.status]),at(c,1).assessments.map(a=>[a.goalId,a.status]));await report(f.run);assert.equal((await verifyReport(f.run)).filesVerified,true);});
test('receipt loss after result commit recovers without duplicated business results',async t=>{const f=await fixture(t);await f.request('inventory',{spaceIds:[]});const p=await f.packet(await f.reserve());const request={schemaVersion:7,operationId:'recover',expectedRevision:(await readExecutionView(f.run)).revision,kind:'import',reason:'Synthetic recovery',packetFile:p.packetFile,review:{decision:'accept',reviewer:'AI',rationale:'Review'}};await assert.rejects(executeRequest({runDir:f.run,request},{afterResultCommit:async()=>{throw Error('Injected receipt loss');}}),/receipt loss/);const rev=(await check(f.run)).revision;await executeRequest({runDir:f.run,request});assert.equal((await check(f.run)).revision,rev);});
test('late assignment may only be preserved as an explicit attempt',async t=>{const f=await fixture(t);await f.request('inventory',{spaceIds:[]});const a=await f.reserve(),p=await f.packet(a);await f.request('reconcile',{assignmentId:a,state:'completed',inFlight:false});await f.reserve();await assert.rejects(f.imported(p.packetFile),/stale assignment/);await f.imported(p.packetFile,{review:{decision:'revise',reviewer:'AI',rationale:'Preserve history',mode:'attempt'}});const c=at((await check(f.run)).cases);assert.equal(c.assessments.length,0);assert.equal(c.entries.length,1);});
test('review can record violation with unknown diagnosis while keeping worker proposal',async t=>{const f=await fixture(t);await f.request('inventory',{spaceIds:[]});const p=await f.packet(await f.reserve());const record=f.payload();at(record.assessments).status='violation';at(record.assessments).diagnosis={state:'unknown',category:'unknown',summary:'Cause not established',evidenceIds:[]};await f.imported(p.packetFile,{review:{decision:'revise',reviewer:'AI',rationale:'Observable violation',record}});assert.equal((await check(f.run)).counts.violation,1);assert.equal(JSON.parse(await fs.readFile(p.packetFile,'utf8')).record.assessments[0].status,'verified');});
test('metadata view is bounded and explicitly does not check evidence',async t=>{const f=await fixture(t);for(let i=0;i<7;i++)await f.request('note',{category:'observation',reason:'Synthetic note '+i+'x'.repeat(300)});const s=await readExecutionQuery(f.run);assert.ok('viewVersion' in s);if('viewVersion' in s){assert.equal(s.viewVersion,7);assert.equal(s.integrity.evidenceFiles,'not_checked');assert.equal(s.notes.items.length,5);assert.equal(s.notes.truncated,true);}});
test('metadata does not parse results; strict read rejects corruption',async t=>{const f=await fixture(t);await fs.writeFile(path.join(f.run,'results.json'),'invalid');await readExecutionQuery(f.run);await assert.rejects(readExecutionView(f.run));});
test('metadata still verifies frozen baseline identity',async t=>{const f=await fixture(t);await fs.appendFile(path.join(f.run,'baseline.json'),' ');await assert.rejects(readExecutionQuery(f.run),/hash mismatch/);});
