/** Synthetic fixture authoring only. Production accepts strict v9 and never uses this helper. */
import fs from 'node:fs/promises';import path from 'node:path';import crypto from 'node:crypto';
import type {Baseline,Case,Goal,Basis,Step} from '../src/contracts/model.mjs';
import {start as startRun} from '../src/core/cases.mjs';import {readCasesFile} from '../src/core/case-versions.mjs';import {reviewCases} from '../src/core/case-review.mjs';import {selectRegression} from '../src/regression/selection.mjs';
type GoalInput=Omit<Goal,'pointId'|'planState'|'preparationGaps'|'sourceAlias'|'clarificationQuestions'|'title'|'basis'>&Partial<Pick<Goal,'pointId'|'planState'|'preparationGaps'|'sourceAlias'|'clarificationQuestions'|'title'>>&{basis:Omit<Basis,'sourceRefIds'>&{sourceRefIds?:string[]}};
type CaseInput=Omit<Case,'parameters'|'goals'|'steps'|'criticalConditions'>&{parameters?:Case['parameters'];goals:GoalInput[];steps:(Omit<Step,'dependsOn'>&{dependsOn?:string[]})[];criticalConditions:(string|Case['criticalConditions'][number])[]};
let serial=0;
export function syntheticCase<T extends CaseInput>(input:T):Case&Omit<T,keyof Case>{return{...input,parameters:input.parameters??[],criticalConditions:input.criticalConditions.map((c,i)=>typeof c==='string'?{id:String(i),text:c}:c),steps:input.steps.map(s=>({...s,dependsOn:s.dependsOn??[]})),goals:input.goals.map(g=>({...g,title:g.title??g.expected,pointId:g.pointId??'SYNTHETIC-TP-'+String(++serial).padStart(6,'0'),basis:{...g.basis,sourceRefIds:g.basis.sourceRefIds??[]},planState:g.planState??'prepared',preparationGaps:g.preparationGaps??[],sourceAlias:g.sourceAlias??null,clarificationQuestions:g.clarificationQuestions??[]}))} as Case&Omit<T,keyof Case>;}
export function syntheticCases(cases:unknown[],project='Synthetic only',extras:Record<string,unknown>={}):Baseline {
 const ids=cases.flatMap(c=>c&&typeof c==='object'&&'goals'in c&&Array.isArray(c.goals)?c.goals:[]).map((g:unknown)=>g&&typeof g==='object'&&'pointId'in g?String(g.pointId):'');const maximum=ids.reduce((n,id)=>Math.max(n,Number(/-TP-([0-9]+)$/.exec(id)?.[1]??0)),0);
 return{schemaVersion:9,projectId:'synthetic-'+crypto.createHash('sha256').update(project).digest('hex').slice(0,16),project,pointPrefix:'SYNTHETIC',caseVersion:1,previous:null,nextPointNumber:maximum+1,retiredPoints:[],sources:[],coverage:[],cases:cases as Case[],changes:[],writeRequestSha256:'0'.repeat(64),savedAt:'2026-11-01T00:00:00.000Z',...extras};
}
export async function prepareSyntheticBinding(options:Parameters<typeof startRun>[0]){
 if(options.bindingFile)return options.bindingFile;
 const saved=await readCasesFile(options.casesFile),review=await reviewCases({casesFile:saved.file,request:{schemaVersion:9,cases:saved.ref,expectedReviewNumber:0,decision:'approved',pointIds:saved.baseline.cases.flatMap(c=>c.goals.map(g=>g.pointId)),comments:[],source:{id:'synthetic-review',locator:'Synthetic protocol fixture '+saved.ref.sha256,file:null,sha256:null,excerpt:'Simulated approval fixture for engineering checks only; not an actual human/business acceptance.',limitations:['Synthetic source data, not a real team review.']},sourceKind:'user_statement',delegationSource:null}});
 const selection=await selectRegression({request:{regressionVersion:2,casesFile:saved.file,cases:saved.ref,mode:'full',pointIds:[],sourceRun:null,statuses:[],includeUnassessedCases:false}});
 const conditions={declaredBy:'Synthetic fixture',declaredAt:new Date().toISOString(),forCurrentRun:true,items:selection.candidatePlans.flatMap(p=>[{id:'auth-'+p.caseId,caseIds:[p.caseId],aspect:'authorization',state:'verified',statement:'Synthetic transaction inputs only, no real business execution.',source:{kind:'current_user_statement',locator:'Synthetic engineering fixture',file:null,sha256:null}},{id:'data-'+p.caseId,caseIds:[p.caseId],aspect:'data',state:'pending',statement:'No real parameter resources are claimed by this fixture.',source:{kind:'ai_declaration',locator:'Synthetic fixture declaration',file:null,sha256:null}}])};
 const binding={regressionVersion:2,selection,reviewFiles:[review.file],plans:selection.candidatePlans,deferred:selection.selectedPointIds.filter(id=>!selection.candidatePlans.some(p=>p.pointIds.includes(id))).map(pointId=>({pointId,reason:'Synthetic case definition is not prepared.'})),parameterBindings:[],currentConditions:conditions,history:{parents:[],primaryBaseline:null,reason:'Synthetic initial run; no historical business execution.'}};
 const filename=path.join(path.resolve(String(options.projectDir)),'binding-'+crypto.randomUUID()+'.json');await fs.writeFile(filename,JSON.stringify(binding,null,2)+'\n',{flag:'wx'});return filename;
}
export async function startSyntheticRun(options:Parameters<typeof startRun>[0]){return startRun({...options,bindingFile:await prepareSyntheticBinding(options)});}
